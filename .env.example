# Database Configuration
POSTGRES_USER=airfare_user
POSTGRES_PASSWORD=airfare_pass
POSTGRES_DB=airfare_observatory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://airfare_user:airfare_pass@localhost:5432/airfare_observatory
DATABASE_URL_ASYNC=postgresql+asyncpg://airfare_user:airfare_pass@localhost:5432/airfare_observatory

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Statistical Methodology Configuration
ACTIVE_METHODOLOGY_VERSION=APIX-2.0
ACTIVE_WEIGHT_VERSION=DGCA_2026_V1
ANCHOR_LEAD_TIME=T+15
BASE_PERIOD=2026-08-01
MINIMUM_COVERAGE_RATE=80.0

# Quality Engine Thresholds
QUALITY_MINIMUM_ACCEPT_SCORE=70
QUALITY_MINIMUM_PLAUSIBLE_PRICE=1200
QUALITY_MAXIMUM_PLAUSIBLE_PRICE=60000
