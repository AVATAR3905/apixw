# =========================== Airfare Observatory — .env ===========================
# Copy to `.env` and adjust. Every variable below maps 1:1 to a Settings field in
# packages/shared/config.py; anything not set falls back to the in-code default.

# --- Database (PostgreSQL; SQLite local fallback used when unreachable) ----------
POSTGRES_USER=airfare_user
POSTGRES_PASSWORD=airfare_pass
POSTGRES_DB=airfare_observatory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://airfare_user:airfare_pass@localhost:5432/airfare_observatory
DATABASE_URL_ASYNC=postgresql+asyncpg://airfare_user:airfare_pass@localhost:5432/airfare_observatory

# --- Redis Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Collection & Caching ---
USE_CACHE=true
CACHE_TTL_SECONDS=1800
BROWSE_POOL_MAX_CONTEXTS=4
BROWSE_CONTEXT_IDLE_SECONDS=300
BROWSE_HEADLESS=true

# SCRAPE_MODE: "live" hits carrier portals / Google Flights RPC over the network
# (with OCR/VLM escalation); "calibrated" serves the deterministic demo baseline
# without network; "hybrid" mixes both.
SCRAPE_MODE=live

# --- Statistical Methodology (Index / Horizon) ---
ACTIVE_METHODOLOGY_VERSION=APIX-2.0
ACTIVE_WEIGHT_VERSION=DGCA_2026_V1
ANCHOR_LEAD_TIME=T+15
BASE_PERIOD=2026-08-01
MINIMUM_COVERAGE_RATE=80.0

# --- Extraction stage control (OCR / VLM escalation) ---
EXTRACTION_ALLOW_VLM=true
# OCR backend: "paddle" (PP-OCRv5/v6, default) | "tesseract" (local CLI v4/v5).
# Both emit identical geometry OCRTokens; absence of either raises the same
# ExtractionNotAvailable, so the chain degrades and escalates to VLM.
EXTRACTION_OCR_BACKEND=paddle
EXTRACTION_ALLOW_OCR=true
# OCR backend: "paddle" (PP-OCRv5/v6 default) | "tesseract" (local CLI v4/v5).
# Absent binaries degrade to the same ExtractionNotAvailable → VLM escalation.
EXTRACTION_OCR_BACKEND=paddle

# --- Quality Engine Thresholds ---
QUALITY_MINIMUM_ACCEPT_SCORE=70
QUALITY_MINIMUM_PLAUSIBLE_PRICE=1200
QUALITY_MAXIMUM_PLAUSIBLE_PRICE=60000

# --- Confidence aggregation thresholds (composite 0..100) ---
CONFIDENCE_HIGH_MIN=90.0
CONFIDENCE_MEDIUM_MIN=70.0

# --- Index variance estimation (NSO-style bootstrap around the point value) ---
INDEX_BOOTSTRAP_REPLICATIONS=2000
INDEX_VARIANCE_CI_LEVEL=0.95
# INDEX_VARIANCE_SEED=<fixed int only for reproducible CI in tests>

# --- OpenRouter AI Copilot ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_VISION_MODEL=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=India Airfare Observatory
